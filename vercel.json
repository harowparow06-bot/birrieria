{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/menu(\\.php)?", "dest": "/api/menu.php" },
    { "src": "/about(\\.php)?", "dest": "/api/about.php" },
    { "src": "/contact(\\.php)?", "dest": "/api/contact.php" },
    { "src": "/privacy-policy(\\.php)?", "dest": "/api/privacy-policy.php" },
    { "src": "/terms-of-service(\\.php)?", "dest": "/api/terms-of-service.php" },
    { "src": "/(index\\.php)?", "dest": "/api/index.php" }
  ]
}
